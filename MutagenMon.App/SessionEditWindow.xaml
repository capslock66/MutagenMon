<Window x:Class="MutagenMon.App.SessionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon" Width="620" Height="760"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,2,2" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name / Alpha / Beta -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Name" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,2" TextChanged="OnValidationFieldChanged" />
            <Label Grid.Row="1" Grid.Column="0" Content="Alpha" />
            <TextBox x:Name="AlphaBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="OnValidationFieldChanged" />
            <Label Grid.Row="2" Grid.Column="0" Content="Beta" />
            <TextBox x:Name="BetaBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="OnValidationFieldChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Options">
                    <StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Sync mode" />
                            <ComboBox x:Name="SyncModeCombo" Grid.Column="1" />
                        </Grid>

                        <Label Content="Ignore" Padding="0,0,0,2" />
                        <TextBox x:Name="IgnoreBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                 Height="70" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="IgnoreVcsCheck" Content="Ignore VCS directories" IsThreeState="True" Margin="0,0,20,0" />
                            <CheckBox x:Name="IgnoreSyntaxDockerCheck" Content="Use Docker ignore syntax" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Permissions mode" />
                            <ComboBox x:Name="PermissionsModeCombo" Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="Permissions" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Session" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Beta" Style="{StaticResource ColumnHeader}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Owner" />
                            <TextBox x:Name="OwnerSessionBox" Grid.Row="1" Grid.Column="1" Margin="2" />
                            <TextBox x:Name="OwnerAlphaBox" Grid.Row="1" Grid.Column="2" Margin="2" />
                            <TextBox x:Name="OwnerBetaBox" Grid.Row="1" Grid.Column="3" Margin="2" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Group" />
                            <TextBox x:Name="GroupSessionBox" Grid.Row="2" Grid.Column="1" Margin="2" />
                            <TextBox x:Name="GroupAlphaBox" Grid.Row="2" Grid.Column="2" Margin="2" />
                            <TextBox x:Name="GroupBetaBox" Grid.Row="2" Grid.Column="3" Margin="2" />

                            <Label Grid.Row="3" Grid.Column="0" Content="File mode" />
                            <TextBox x:Name="FileModeSessionBox" Grid.Row="3" Grid.Column="1" Margin="2" />
                            <TextBox x:Name="FileModeAlphaBox" Grid.Row="3" Grid.Column="2" Margin="2" />
                            <TextBox x:Name="FileModeBetaBox" Grid.Row="3" Grid.Column="3" Margin="2" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Directory mode" />
                            <TextBox x:Name="DirectoryModeSessionBox" Grid.Row="4" Grid.Column="1" Margin="2" />
                            <TextBox x:Name="DirectoryModeAlphaBox" Grid.Row="4" Grid.Column="2" Margin="2" />
                            <TextBox x:Name="DirectoryModeBetaBox" Grid.Row="4" Grid.Column="3" Margin="2" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Symbolic links" />
                            <ComboBox x:Name="SymlinkModeCombo" Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="Watching" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Session" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Beta" Style="{StaticResource ColumnHeader}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Watch mode" />
                            <ComboBox x:Name="WatchModeSessionCombo" Grid.Row="1" Grid.Column="1" Margin="2" />
                            <ComboBox x:Name="WatchModeAlphaCombo" Grid.Row="1" Grid.Column="2" Margin="2" />
                            <ComboBox x:Name="WatchModeBetaCombo" Grid.Row="1" Grid.Column="3" Margin="2" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Polling interval (s)" />
                            <TextBox x:Name="WatchPollingIntervalSessionBox" Grid.Row="2" Grid.Column="1" Margin="2" />
                            <TextBox x:Name="WatchPollingIntervalAlphaBox" Grid.Row="2" Grid.Column="2" Margin="2" />
                            <TextBox x:Name="WatchPollingIntervalBetaBox" Grid.Row="2" Grid.Column="3" Margin="2" />
                        </Grid>

                        <TextBlock Text="Probing and scanning" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Session" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Beta" Style="{StaticResource ColumnHeader}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Probe mode" />
                            <ComboBox x:Name="ProbeModeSessionCombo" Grid.Row="1" Grid.Column="1" Margin="2" />
                            <ComboBox x:Name="ProbeModeAlphaCombo" Grid.Row="1" Grid.Column="2" Margin="2" />
                            <ComboBox x:Name="ProbeModeBetaCombo" Grid.Row="1" Grid.Column="3" Margin="2" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Scan mode" />
                            <ComboBox x:Name="ScanModeSessionCombo" Grid.Row="2" Grid.Column="1" Margin="2" />
                            <ComboBox x:Name="ScanModeAlphaCombo" Grid.Row="2" Grid.Column="2" Margin="2" />
                            <ComboBox x:Name="ScanModeBetaCombo" Grid.Row="2" Grid.Column="3" Margin="2" />
                        </Grid>

                        <TextBlock Text="Staging" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Session" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Beta" Style="{StaticResource ColumnHeader}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Stage mode" />
                            <ComboBox x:Name="StageModeSessionCombo" Grid.Row="1" Grid.Column="1" Margin="2" />
                            <ComboBox x:Name="StageModeAlphaCombo" Grid.Row="1" Grid.Column="2" Margin="2" />
                            <ComboBox x:Name="StageModeBetaCombo" Grid.Row="1" Grid.Column="3" Margin="2" />
                        </Grid>

                        <TextBlock Text="Limit" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Max staging file size" />
                            <TextBox x:Name="MaxStagingFileSizeBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />
                            <Label Grid.Row="1" Grid.Column="0" Content="Max entry count" />
                            <TextBox x:Name="MaxEntryCountBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                        </Grid>

                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="UnknownFlagsGroup" Visibility="Collapsed">
                    <GroupBox.Header>
                        <TextBlock Text="Unknown flags" Foreground="Red" FontWeight="Bold" />
                    </GroupBox.Header>
                    <ItemsControl x:Name="UnknownFlagsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}" IsChecked="{Binding Keep}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Content="Save" Width="90" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
