<Window x:Class="MutagenMon.App.ScriptRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon: Script run" Width="760" Height="480"
        MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FR-56.5 / FR-52.1: read-only output, stderr in red. -->
        <RichTextBox x:Name="OutputBox" Grid.Row="0" IsReadOnly="True"
                     FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <RichTextBox.Document>
                <FlowDocument PageWidth="5000" />
            </RichTextBox.Document>
        </RichTextBox>

        <!-- FR-52.3: elapsed time while running, then the outcome of the run. -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- FR-56.5: Cancel only while the script runs, Close only once it has ended. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelRunButton" Content="Cancel" Width="90" IsEnabled="False" Click="OnCancelClick" />
            <Button x:Name="CloseButton" Content="Close" Width="90" Margin="8,0,0,0" IsEnabled="False" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
