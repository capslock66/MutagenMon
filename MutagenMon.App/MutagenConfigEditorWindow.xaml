<Window x:Class="MutagenMon.App.MutagenConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon: Edit mutagen config" Width="720" Height="560"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FR-30.4: shown only when the file didn't exist at load time. -->
        <TextBlock x:Name="NewFileNoticeText" Grid.Row="0"
                   Text="File does not exist yet — it will be created on Save."
                   FontStyle="Italic" Margin="0,0,0,8" Visibility="Collapsed" />

        <TextBox x:Name="EditorBox" Grid.Row="1"
                 FontFamily="Consolas"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 BorderThickness="1" Padding="6" />

        <!-- FR-31.1: red, hidden when there is nothing to report. -->
        <TextBlock x:Name="ValidationErrorText" Grid.Row="2"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="CheckButton" Content="Check" Width="90" Click="OnCheckClick" />
                <Button x:Name="SaveButton" Content="Save" Width="90" Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick" />
                <!-- FR-33: disabled until a Save actually persists a change (see code-behind). -->
                <Button x:Name="ReloadConfigButton" Content="Reload config &amp; restart" Width="160"
                        Margin="8,0,0,0" IsEnabled="False" Click="OnReloadConfigClick" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Close" Width="90" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
