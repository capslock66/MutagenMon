<UserControl x:Class="MutagenMon.App.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Search bar shared by the Scripts and Logs tabs: Ctrl+F opens it, F3 / Shift+F3 (or Enter / Shift+Enter
         in the box) go to the next / previous match, Esc closes it. The owning view runs the actual search. -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBox x:Name="SearchBox" Width="220" VerticalContentAlignment="Center"
                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
        <Button x:Name="PreviousButton" Content="&#x25B2;" Width="28" Margin="6,0,0,0" Focusable="False"
                ToolTip="Previous match (Shift+F3)" Click="OnPreviousClick" />
        <Button x:Name="NextButton" Content="&#x25BC;" Width="28" Margin="4,0,0,0" Focusable="False"
                ToolTip="Next match (F3)" Click="OnNextClick" />
        <CheckBox x:Name="MatchCaseCheck" Content="Match case" VerticalAlignment="Center" Margin="10,0,0,0"
                  Checked="OnMatchCaseChanged" Unchecked="OnMatchCaseChanged" />
        <TextBlock x:Name="ResultText" Foreground="Red" VerticalAlignment="Center" Margin="10,0,0,0" />
        <Button x:Name="CloseButton" Content="&#x2715;" Width="28" Margin="10,0,0,0"
                ToolTip="Close (Esc)" Click="OnCloseClick" />
    </StackPanel>
</UserControl>
