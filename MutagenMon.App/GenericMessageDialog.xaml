<Window x:Class="MutagenMon.App.GenericMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="BodyText" Grid.Row="0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="OnCancelClick" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
