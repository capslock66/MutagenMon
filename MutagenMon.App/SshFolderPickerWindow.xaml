<Window x:Class="MutagenMon.App.SshFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MutagenMon: Browse SSH server" Width="480" Height="480"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Server" />
            <ComboBox x:Name="ServerCombo" Grid.Column="1" SelectionChanged="OnServerSelectionChanged" />
        </Grid>

        <TextBlock x:Name="NoServersText" Grid.Row="1" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="No SSH servers are configured. Add one in the &quot;Mutagen monitor Configuration&quot; tab." />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Selected" />
            <TextBox x:Name="SelectedPathBox" Grid.Column="1" IsReadOnly="True" Background="{x:Static SystemColors.ControlLightBrush}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Top"
                   Visibility="Collapsed" />

        <TreeView x:Name="FolderTree" Grid.Row="3"
                  SelectedItemChanged="OnFolderTreeSelectedItemChanged" />

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="NewFolderButton" Grid.Column="0" HorizontalAlignment="Left"
                    IsEnabled="False" Padding="8,4" Click="OnNewFolderClick">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FolderPlusOutline" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="New folder" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True" />
                <Button x:Name="OkButton" Content="OK" Width="90" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
