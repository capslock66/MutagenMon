<Application x:Class="MutagenMon.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="MutagenMon: waiting for status..." TrayLeftMouseUp="OnShowStatusClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="OnTrayContextMenuOpened">
                    <MenuItem Header="Reload config &amp; restart mutagen" Click="OnReloadClick" />
                    <MenuItem Header="Stop Mutagen sessions" Click="OnToggleMonitoringClick" />
                    <Separator />
                    <MenuItem Header="Show status" Click="OnShowStatusClick" />
                    <Separator />
                    <MenuItem Header="Reloading..." IsEnabled="False" Visibility="Collapsed" />
                    <MenuItem Header="Exit MutagenMon" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
