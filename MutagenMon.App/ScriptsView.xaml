<UserControl x:Class="MutagenMon.App.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MutagenMon.App">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Link to the scripts file itself, opened with the OS default editor. -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8">
            <Hyperlink x:Name="OpenFileLink" Click="OnOpenFileLinkClick" ToolTip="Open in the default editor" />
        </TextBlock>

        <!-- FR-47.2: Reload, Run, Cancel (only while a script is running). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button x:Name="ReloadButton" Content="Reload" Width="90" Click="OnReloadClick" />
            <Button x:Name="AddButton" Content="Add" Width="90" Margin="8,0,0,0" Click="OnAddClick" />
            <Button x:Name="DeleteButton" Content="Delete" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="OnDeleteClick" />
            <Button x:Name="SaveButton" Content="Save" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="OnSaveClick" />
            <Button x:Name="RunButton" Content="Run" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="OnRunClick" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="OnCancelClick" />
        </StackPanel>

        <!-- FR-49.2: informational message (missing/unreadable file), never a dialog. -->
        <TextBlock x:Name="InfoText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <!-- FR-47.3: script list on the left; script text above the output on the right. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Script tree (groups, then ungrouped scripts), with buttons to move the selected script or group up or down. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TreeView x:Name="ScriptTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnScriptTreeSelectedItemChanged"
                          PreviewMouseLeftButtonDown="OnScriptTreePreviewMouseLeftButtonDown">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <!-- Group node: bold name and script count; its scripts are the children. -->
                        <HierarchicalDataTemplate DataType="{x:Type local:ScriptGroupNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}" FontWeight="Bold" Margin="2" />
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:ScriptListItem}">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="MoveUpButton" Content="&#x25B2;" Width="40" IsEnabled="False"
                            ToolTip="Move up" Click="OnMoveUpClick" />
                    <Button x:Name="MoveDownButton" Content="&#x25BC;" Width="40" Margin="8,0,0,0" IsEnabled="False"
                            ToolTip="Move down" Click="OnMoveDownClick" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray" />

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Name of the script (its section header in the file), saved together with the text. -->
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ScriptNameBox" Grid.Column="1" IsReadOnly="True"
                                 TextChanged="OnScriptNameChanged" />
                    </Grid>
                    <TextBlock x:Name="NameErrorText" Foreground="Red" TextWrapping="Wrap"
                               Margin="0,2,0,0" Visibility="Collapsed" />
                </StackPanel>

                <TextBox x:Name="ScriptText" Grid.Row="1" IsReadOnly="True"
                         AcceptsReturn="True" AcceptsTab="True" TextChanged="OnScriptTextChanged"
                         TextWrapping="NoWrap" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="LightGray" />

                <!-- FR-52: read-only output, stderr in red. -->
                <RichTextBox x:Name="OutputBox" Grid.Row="3" IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <RichTextBox.Document>
                        <FlowDocument PageWidth="5000" />
                    </RichTextBox.Document>
                </RichTextBox>

                <!-- FR-52.3: outcome of the run (exit code, cancelled/timed out, duration), kept out of the streamed output. -->
                <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
