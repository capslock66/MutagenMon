<Window x:Class="MutagenMon.App.SecretValuesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon: Script secrets" Width="440" SizeToContent="Height"
        MinWidth="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Type the values this script asks for. They are used for this run only and are never stored." />

        <!-- One row per distinct secret label, built in code: a PasswordBox cannot be data-bound. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400" Focusable="False">
            <Grid x:Name="RowsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True" />
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="8,0,0,0" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
