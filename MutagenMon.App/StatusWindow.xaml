<Window x:Class="MutagenMon.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MutagenMon.App"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MutagenMon" Height="480" Width="900"
        MinHeight="320" MinWidth="640"
        ResizeMode="CanResize"
        Icon="pack://siteoforigin:,,,/Assets/Icons/app_icon_monitor.ico">
    <Window.Resources>
        <local:IconKeyToImageSourceConverter x:Key="IconKeyToImageSourceConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Sync">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- FR-16: toolbar above the grid — Add, Duplicate and Stop/Start sessions. -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="AddSessionButton"
                                Padding="8,4" Click="OnAddSessionClick" ToolTip="Add session">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PlusThick" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Add" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DuplicateSessionButton" IsEnabled="False"
                                Margin="8,0,0,0" Padding="8,4" Click="OnDuplicateSessionClick" ToolTip="Duplicate session">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Duplicate" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ToggleMonitoringButton" Content="Stop Mutagen sessions" Width="150"
                                Margin="8,0,0,0" Click="OnToggleMonitoringClick" />
                    </StackPanel>

                    <Button x:Name="ResolveConflictsButton" Content="Resolve conflicts" Width="130"
                            HorizontalAlignment="Right" Click="OnResolveConflictsClick" />
                    </Grid>

                    <DataGrid x:Name="SessionsGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="OnSessionsGridSelectionChanged"
                              MouseDoubleClick="OnSessionsGridMouseDoubleClick">
                        <!-- A session with unresolved conflicts is shown entirely in red. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConflictCount}" Value="0">
                                        <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Foreground" Value="Red" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- FR-17.1: Edit/Delete row actions, leftmost, before Name.
                                 FR-28: View sync status, leftmost of the three. -->
                            <DataGridTemplateColumn Header="" Width="Auto" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="OnViewSyncStatusClick" ToolTip="View sync status"
                                                    Padding="2" Background="Transparent" BorderThickness="0">
                                                <iconPacks:PackIconMaterial Kind="EyeOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Click="OnEditSessionClick" ToolTip="Edit session"
                                                    Margin="4,0,0,0"
                                                    Padding="2" Background="Transparent" BorderThickness="0">
                                                <iconPacks:PackIconMaterial Kind="PencilOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Click="OnDeleteSessionClick" ToolTip="Delete session"
                                                    Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0">
                                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="Status" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconKey, Converter={StaticResource IconKeyToImageSourceConverter}}"
                                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Conflict" Binding="{Binding ConflictDisplay}" Width="Auto" />
                            <DataGridTextColumn Header="Alpha" Binding="{Binding AlphaUrl}" Width="2*" />
                            <DataGridTextColumn Header="Beta" Binding="{Binding BetaUrl}" Width="2*" />
                            <DataGridTextColumn Header="Last changed" Binding="{Binding LastChangedDisplay}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Conflicts:" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,8,0" />
                        <TextBlock x:Name="ConflictsText" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Mutagen Configuration">
                <local:MutagenConfigEditorView x:Name="MutagenConfigEditorViewControl" />
            </TabItem>

            <TabItem Header="Mutagen monitor Configuration">
                <local:MutagenMonitorConfigEditorView x:Name="MutagenMonitorConfigEditorViewControl" />
            </TabItem>

            <TabItem Header="Logs">
                <local:LogsView x:Name="LogsViewControl" />
            </TabItem>
        </TabControl>

        <!-- Toolbar shared by every tab, below the TabControl: Reload
             config & restart, left of Exit mutagen monitor. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ReloadConfigButton"
                        Padding="8,4" Click="OnReloadConfigClick" ToolTip="Reload config &amp; restart mutagen">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CogRefreshOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Reload config &amp; restart" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExitButton" Content="Exit mutagen monitor" Width="130" Margin="8,0,0,0" Click="OnExitClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
