<Window x:Class="MutagenMon.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MutagenMon.App"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MutagenMon" Height="480" Width="900"
        MinHeight="320" MinWidth="780"
        ResizeMode="CanResize"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Icon="pack://siteoforigin:,,,/Assets/Icons/app_icon_monitor.ico">
    <Window.Resources>
        <local:IconKeyToImageSourceConverter x:Key="IconKeyToImageSourceConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem x:Name="SyncTab" Header="Sync">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Link to the sessions file (mutagen-create.bat), opened with the "edit" verb (never run, it is a .bat). -->
                    <TextBlock Grid.Row="0" Margin="0,0,0,8">
                        <Hyperlink x:Name="OpenSessionsFileLink" Click="OnOpenSessionsFileLinkClick" ToolTip="Open in the default editor" />
                    </TextBlock>

                    <!-- FR-16 / FR-56.1: toolbar above the grid, all on the left: Add, Pause/Resume sessions, Stop/Start sessions,
                         then Resolve conflicts (greyed out while there is no conflict). -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Button x:Name="AddSessionButton"
                                Padding="8,4" Click="OnAddSessionClick" ToolTip="Add session">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PlusThick" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Add" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- FR-67.2: global Pause/Resume. -->
                        <Button x:Name="PauseResumeAllButton" Content="Pause sessions" Width="130"
                                Margin="8,0,0,0" Click="OnPauseResumeAllClick" />
                        <Button x:Name="ToggleMonitoringButton" Content="Stop sessions" Width="130"
                                Margin="8,0,0,0" Click="OnToggleMonitoringClick" />
                        <Button x:Name="ResolveConflictsButton" Content="Resolve conflicts" Width="130"
                                Margin="8,0,0,0" IsEnabled="False" Click="OnResolveConflictsClick" />
                    </StackPanel>

                    <DataGrid x:Name="SessionsGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="OnSessionsGridSelectionChanged"
                              PreviewMouseRightButtonDown="OnSessionsGridPreviewMouseRightButtonDown"
                              MouseDoubleClick="OnSessionsGridMouseDoubleClick">
                        <!-- A session with unresolved conflicts is shown entirely in red. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConflictCount}" Value="0">
                                        <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}" />
                                    </DataTrigger>
                                    <!-- FR-57.3: a session halted by a Mutagen safety check gets a red background
                                         with white text (legible in light and dark themes). Declared after the
                                         conflict trigger so its foreground wins. -->
                                    <DataTrigger Binding="{Binding IsHalted}" Value="True">
                                        <Setter Property="Background" Value="#FFC62828" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Foreground" Value="Red" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- FR-17.1 / FR-28 / FR-67.1: row actions menu, leftmost, before Name. -->
                            <DataGridTemplateColumn Header="" Width="Auto" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- FR-60.1: "Accept deletion", only on a row halted by a root emptying. -->
                                            <Button Click="OnAcceptDeletionClick" ToolTip="Accept deletion"
                                                    Margin="0,0,4,0"
                                                    Padding="2" Background="Transparent" BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRootEmptyingHalt}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" />
                                            </Button>
                                            <!-- One hamburger button per row (the same menu opens on a right click): View sync status,
                                                 Pause/Resume, Edit, Delete, Duplicate, then one entry per session script. -->
                                            <Button Click="OnSessionMenuClick" ToolTip="Actions"
                                                    Padding="2" Background="Transparent" BorderThickness="0">
                                                <iconPacks:PackIconMaterial Kind="Menu" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding SyncMode}" Width="Auto" />
                            <DataGridTemplateColumn Header="Status" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconKey, Converter={StaticResource IconKeyToImageSourceConverter}}"
                                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Conflict" Binding="{Binding ConflictDisplay}" Width="Auto" />
                            <DataGridTextColumn Header="Alpha" Binding="{Binding AlphaUrl}" Width="2*" />
                            <DataGridTextColumn Header="Beta" Binding="{Binding BetaUrl}" Width="2*" />
                            <DataGridTextColumn Header="Last changed" Binding="{Binding LastChangedDisplay}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Conflicts:" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,8,0" />
                        <TextBlock x:Name="ConflictsText" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="ScriptsTab" Header="Scripts">
                <local:ScriptsView x:Name="ScriptsViewControl" />
            </TabItem>

            <TabItem Header="Mutagen Configuration">
                <local:MutagenConfigEditorView x:Name="MutagenConfigEditorViewControl" />
            </TabItem>

            <TabItem Header="Mutagen monitor Configuration">
                <local:MutagenMonitorConfigEditorView x:Name="MutagenMonitorConfigEditorViewControl" />
            </TabItem>

            <TabItem Header="Logs">
                <local:LogsView x:Name="LogsViewControl" />
            </TabItem>
        </TabControl>

        <!-- Toolbar shared by every tab, below the TabControl: Reload config & restart and the update button
             (FR-66.6) on the left; Exit mutagen monitor at the far right. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ReloadConfigButton"
                        Padding="8,4" Click="OnReloadConfigClick" ToolTip="Reload config &amp; restart mutagen">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CogRefreshOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Reload config &amp; restart" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- FR-66.6: visible while DeployPath is not empty. "Check for new version" until a newer MutagenMon.exe is found in the
                     deploy folder, then "Update available". -->
                <Button x:Name="UpdateButton" Margin="8,0,0,0" Padding="8,4" Click="OnUpdateClick">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial x:Name="UpdateButtonIcon" Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpdateButtonText" Text="Check for new version" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="ExitButton" Content="Exit mutagen monitor" Width="130" HorizontalAlignment="Right" Click="OnExitClick" />
        </Grid>
    </Grid>
</Window>
