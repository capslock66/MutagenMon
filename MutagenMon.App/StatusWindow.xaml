<Window x:Class="MutagenMon.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon" Height="480" Width="900"
        MinHeight="320" MinWidth="640"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image x:Name="StatusIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="MutagenMon" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid x:Name="SessionsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
                <DataGridTextColumn Header="Alpha" Binding="{Binding AlphaUrl}" Width="2*" />
                <DataGridTextColumn Header="Beta" Binding="{Binding BetaUrl}" Width="2*" />
                <DataGridTextColumn Header="Last changed" Binding="{Binding LastChangedDisplay}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ConflictsText" Grid.Row="2" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" Click="OnCancelClick" />
            <Button x:Name="ResolveConflictsButton" Content="Resolve conflicts" Width="130" Margin="8,0,0,0" Click="OnResolveConflictsClick" />
        </StackPanel>
    </Grid>
</Window>
