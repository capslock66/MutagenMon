<Window x:Class="MutagenMon.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutagenMon" Height="420" Width="520"
        MinHeight="240" MinWidth="360">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image x:Name="StatusIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="MutagenMon" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontFamily="Consolas" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" Click="OnCancelClick" />
            <Button x:Name="ResolveConflictsButton" Content="Resolve conflicts" Width="130" Margin="8,0,0,0" Click="OnResolveConflictsClick" />
        </StackPanel>
    </Grid>
</Window>
