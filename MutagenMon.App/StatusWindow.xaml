<Window x:Class="MutagenMon.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MutagenMon.App"
        Title="MutagenMon" Height="480" Width="900"
        MinHeight="320" MinWidth="640"
        ResizeMode="CanResize">
    <Window.Resources>
        <local:IconKeyToImageSourceConverter x:Key="IconKeyToImageSourceConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="SessionsGrid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTemplateColumn Header="Status" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconKey, Converter={StaticResource IconKeyToImageSourceConverter}}"
                                       Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Alpha" Binding="{Binding AlphaUrl}" Width="2*" />
                <DataGridTextColumn Header="Beta" Binding="{Binding BetaUrl}" Width="2*" />
                <DataGridTextColumn Header="Last changed" Binding="{Binding LastChangedDisplay}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ConflictsText" Grid.Row="1" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,12,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ReloadConfigButton" Content="Reload config" Width="110" Click="OnReloadConfigClick" />
            <Button x:Name="ToggleMonitoringButton" Content="Stop Mutagen sessions" Width="150" Margin="8,0,0,0" Click="OnToggleMonitoringClick" />
            <Button x:Name="ExitButton" Content="Exit" Width="90" Margin="8,0,0,0" Click="OnExitClick" />
            <Button x:Name="CloseButton" Content="Close" Width="90" Margin="16,0,0,0" Click="OnCloseClick" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" Click="OnCancelClick" />
            <Button x:Name="ResolveConflictsButton" Content="Resolve conflicts" Width="130" Margin="8,0,0,0" Click="OnResolveConflictsClick" />
        </StackPanel>
    </Grid>
</Window>
